<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0-preview.3</Version>
    <PackageId>Fsdb</PackageId>
    <Authors>Helge Sverre</Authors>
    <Description>An embeddable F# database with a MySQL-compatible SQL engine and wire protocol.</Description>
    <PackageTags>FSharp;database;SQL;MySQL;embedded</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/HelgeSverre/fsdb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Foundation/Log.fs" />
    <Compile Include="Foundation/Collections.fs" />
    <Compile Include="Foundation/DynamicScope.fs" />
    <Compile Include="Foundation/SqlState.fs" />
    <Compile Include="Foundation/Diagnostics.fs" />
    <Compile Include="Foundation/GroupCommit.fs" />
    <Compile Include="Foundation/OptionFile.fs" />
    <Compile Include="Foundation/StorageOptions.fs" />
    <Compile Include="Foundation/Limits.fs" />
    <Compile Include="Engine/Authentication.fs" />
    <Compile Include="Foundation/ServerOptions.fs" />
    <Compile Include="Foundation/Binary.fs" />
    <Compile Include="Sql/SingleByteCharset.fs" />
    <Compile Include="Sql/Charset.fs" />
    <Compile Include="Sql/Collation.fs" />
    <Compile Include="Sql/Regexp.fs" />
    <Compile Include="Sql/Temporal.fs" />
    <Compile Include="Sql/TemporalLocale.fs" />
    <Compile Include="Sql/Value.fs" />
    <Compile Include="Sql/SpatialReferenceSystems.fs" />
    <Compile Include="Sql/GeometryOperations.fs" />
    <Compile Include="Sql/Privileges.fs" />
    <Compile Include="Sql/FullText.fs" />
    <Compile Include="Sql/Ast.fs" />
    <Compile Include="Sql/ForeignKeyIndexes.fs" />
    <Compile Include="Sql/SqlText.fs" />
    <Compile Include="Sql/Expression.fs" />
    <Compile Include="Sql/FunctionalIndex.fs" />
    <Compile Include="Sql/Deprecation.fs" />
    <Compile Include="Sql/ColumnWire.fs" />
    <Compile Include="Sql/ColumnDisplay.fs" />
    <Compile Include="Sql/PreparedVariables.fs" />
    <Compile Include="Sql/Parser.fs" />
    <Compile Include="Sql/OptimizerHints.fs" />
    <Compile Include="Sql/OptimizerHintScopes.fs" />
    <Compile Include="Sql/OptimizerHintResolution.fs" />
    <Compile Include="Sql/LoadData.fs" />
    <Compile Include="Sql/Xa.fs" />
    <Compile Include="Sql/StoredProgram.fs" />
    <Compile Include="Sql/SqlMode.fs" />
    <Compile Include="Sql/Functions.fs" />
    <Compile Include="Sql/Event.fs" />
    <Compile Include="Engine/SystemCatalog.fs" />
    <Compile Include="Engine/PagedVector.fs" />
    <Compile Include="Engine/RowStore.fs" />
    <Compile Include="Engine/SpatialIndex.fs" />
    <Compile Include="Engine/Storage.fs" />
    <Compile Include="Engine/TimeZones.fs" />
    <Compile Include="Engine/TransactionRegistry.fs" />
    <Compile Include="Engine/Auth.fs" />
    <Compile Include="Engine/TableLocks.fs" />
    <Compile Include="Engine/Persistence.fs" />
    <Compile Include="Engine/InnoDbMetadata.fs" />
    <Compile Include="Engine/InformationSchemaKeywords.fs" />
    <Compile Include="Engine/InformationSchema.fs" />
    <Compile Include="Engine/QueryPlanner.fs" />
    <Compile Include="Engine/Executor.fs" />
    <Compile Include="Wire/Compression.fs" />
    <Compile Include="Wire/Packet.fs" />
    <Compile Include="Wire/Protocol.fs" />
    <Compile Include="Wire/PreparedMetadata.fs" />
    <Compile Include="Wire/Session.fs" />
    <Compile Include="Wire/CatalogOverlay.fs" />
    <Compile Include="Wire/TableHandler.fs" />
    <Compile Include="Wire/QueryHandler.fs" />
    <Compile Include="Engine/EventScheduler.fs" />
    <Compile Include="Wire/Server.fs" />
    <Compile Include="Db.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
