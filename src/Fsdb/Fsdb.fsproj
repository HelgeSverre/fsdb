<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Log.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="OptionFile.fs" />
    <Compile Include="Limits.fs" />
    <Compile Include="Binary.fs" />
    <Compile Include="Collation.fs" />
    <Compile Include="Value.fs" />
    <Compile Include="FullText.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="ColumnWire.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Functions.fs" />
    <Compile Include="PagedVector.fs" />
    <Compile Include="RowStore.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="InformationSchema.fs" />
    <Compile Include="Executor.fs" />
    <Compile Include="Packet.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="QueryHandler.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Db.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="FParsec" Version="1.1.1" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
  </ItemGroup>

</Project>
