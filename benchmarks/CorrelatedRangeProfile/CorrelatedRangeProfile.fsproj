<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <FsdbProject Condition="'$(FsdbProject)' == ''">../../src/Fsdb/Fsdb.fsproj</FsdbProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <ProjectReference Include="$(FsdbProject)" />
  </ItemGroup>
</Project>
